{
	"name": "zer0-sh/zer0sh-site-health-monitor",
	"description": "Ultra lightweight WordPress plugin to monitor your website's performance, health, and security.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "zer0sh",
			"homepage": "https://github.com/zer0-sh/zer0sh-site-health-monitor"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Zer0sh\\SiteHealthMonitor\\Admin\\": "admin/",
			"Zer0sh\\SiteHealthMonitor\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Zer0sh\\SiteHealthMonitor\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "vendor/bin/phpcs",
		"lint:fix": "vendor/bin/phpcbf",
		"test": "vendor/bin/phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		},
		"sort-packages": true
	}
}